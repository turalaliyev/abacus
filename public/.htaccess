# SPA fallback for a URL with no matching file or directory — e.g. a typo,
# a dead inbound link, or a dynamic CMS slug added since the last build.
# Most routes already have their own prerendered index.html (see
# scripts/postbuild.mjs) and never reach this at all.
#
# ErrorDocument (not a mod_rewrite catch-all to index.html) is what makes this
# a real HTTP 404 rather than a 200: Apache serves index.html's content as the
# body, so the client-side router still renders — <NotFound> sets a friendly
# title and noindex once React mounts — but the initial response status stays
# 404, which is what tells crawlers this isn't real content. A rewrite that
# resolves successfully to index.html would report 200 for every dead URL, a
# "soft 404" that search consoles flag and that muddies which URLs actually
# exist.
ErrorDocument 404 /index.html

# Compress text-based assets.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# Long-cache hashed build assets; never cache HTML so deploys show up immediately.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
